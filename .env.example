# OpenRouter API Configuration
# Get your key at https://openrouter.ai/keys
# The service works on rule-based logic without a key; LLM enhancement is optional
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-next-80b-a3b-instruct:free

# Server Configuration
PORT=8000

# LLM Parameters
LLM_TIMEOUT=25
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.1
